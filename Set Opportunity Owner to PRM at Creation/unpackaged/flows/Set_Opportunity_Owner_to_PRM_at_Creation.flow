<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Is the Constituent&apos;s PRM field populated?</description>
        <name>Constituent_have_PRM</name>
        <label>Constituent have PRM?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No PRM</defaultConnectorLabel>
        <rules>
            <name>Yes_Constituent_has_PRM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__Contact__r.ucinn_ascendv2__PRM__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opportunity_Owner_to_Constituent_PRM</targetReference>
            </connector>
            <label>Yes, Constituent has PRM</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines if the Donor is an Organization or a Constituent</description>
        <name>Donor_Type</name>
        <label>Donor Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not an Organization or Constituent</defaultConnectorLabel>
        <rules>
            <name>Organization_Donor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Organization_have_PRM</targetReference>
            </connector>
            <label>Organization Donor</label>
        </rules>
        <rules>
            <name>Constituent_Donor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ucinn_ascendv2__Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Constituent_have_PRM</targetReference>
            </connector>
            <label>Constituent Donor</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the Organization&apos;s PRM field populated?</description>
        <name>Organization_have_PRM</name>
        <label>Organization have PRM?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No PRM</defaultConnectorLabel>
        <rules>
            <name>Yes_Organization_has_PRM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.ucinn_ascendv2__PRM__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opportunity_Owner_to_Organization_PRM</targetReference>
            </connector>
            <label>Yes, Organization has PRM</label>
        </rules>
    </decisions>
    <description>Sets the Opportunity Owner to the PRM at the time of the Opportunity record&apos;s creation.</description>
    <environments>Default</environments>
    <interviewLabel>Set Opportunity Owner to PRM at Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Opportunity Owner to PRM at Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Sets the Owner of the Opportunity to the PRM, this sets the Opportunity Team and Opportunity Splits to be the PRM.</description>
        <name>Set_Opportunity_Owner_to_Constituent_PRM</name>
        <label>Set Opportunity Owner to Constituent PRM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.ucinn_ascendv2__Contact__r.ucinn_ascendv2__PRM__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Sets the Owner of the Opportunity to the PRM, this sets the Opportunity Team and Opportunity Splits to be the PRM.</description>
        <name>Set_Opportunity_Owner_to_Organization_PRM</name>
        <label>Set Opportunity Owner to Organization PRM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Account.ucinn_ascendv2__PRM__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Donor_Type</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
